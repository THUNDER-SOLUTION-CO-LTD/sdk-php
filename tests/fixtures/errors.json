{
  "classes": {
    "ApiError": {
      "parent": "root",
      "description": "Any HTTP error response. Carries status, code, message, requestId, rawBody, headers."
    },
    "AuthenticationError": {
      "parent": "ApiError",
      "description": "The API key is missing, malformed or unknown."
    },
    "PermissionDeniedError": {
      "parent": "ApiError",
      "description": "The key is valid but the account, branch or IP may not call this endpoint."
    },
    "QuotaExceededError": {
      "parent": "PermissionDeniedError",
      "description": "The service quota is used up. Nothing was charged."
    },
    "InvalidRequestError": {
      "parent": "ApiError",
      "description": "The API rejected the request body, query or parameters."
    },
    "InvalidImageError": {
      "parent": "InvalidRequestError",
      "description": "The image is missing, too large, not an image, or not a slip of the right kind."
    },
    "InvalidUrlError": {
      "parent": "InvalidRequestError",
      "description": "An image URL or callback URL was refused (protocol, private address, unreachable)."
    },
    "DuplicateSlipError": {
      "parent": "InvalidRequestError",
      "description": "v1 only. The slip was verified before; `slip` holds the parsed original slip."
    },
    "NotFoundError": {
      "parent": "ApiError",
      "description": "The resource (bank account, job, route) does not exist or is not visible to this branch."
    },
    "SlipNotFoundError": {
      "parent": "NotFoundError",
      "description": "The bank or wallet could not find the slip, or no QR code was found in the image."
    },
    "SlipPendingError": {
      "parent": "NotFoundError",
      "description": "Bangkok Bank slip from the last few minutes; try again later."
    },
    "ConflictError": {
      "parent": "ApiError",
      "description": "The request conflicts with existing data (duplicate bank account)."
    },
    "RateLimitError": {
      "parent": "ApiError",
      "description": "Too many requests. Carries retryAfter (seconds) when the API sends Retry-After."
    },
    "ServerError": {
      "parent": "ApiError",
      "description": "5xx from the API or an upstream bank service."
    },
    "ServiceUnavailableError": {
      "parent": "ServerError",
      "description": "503, a dependency is briefly unavailable. Usually sent with Retry-After."
    },
    "NetworkError": {
      "parent": "root",
      "description": "No HTTP response (DNS, connect, TLS, reset). Carries the underlying cause."
    },
    "RequestTimeoutError": {
      "parent": "NetworkError",
      "description": "The client-side timeout fired before a response arrived."
    },
    "InputError": {
      "parent": "root",
      "description": "Rejected by the SDK before sending. Has a `code` from inputErrorCodes."
    },
    "WebhookSignatureError": {
      "parent": "root",
      "description": "Webhook signature header missing, malformed or not matching the raw body."
    },
    "JobWaitTimeoutError": {
      "parent": "root",
      "description": "waitForJob gave up before the job finished. Carries the last polled job."
    },
    "BatchSubmitError": {
      "parent": "root",
      "description": "submitBankMany failed part way. Carries the batches already accepted and the cause."
    }
  },
  "statusFallback": {
    "400": "InvalidRequestError",
    "401": "AuthenticationError",
    "403": "PermissionDeniedError",
    "404": "NotFoundError",
    "409": "ConflictError",
    "429": "RateLimitError",
    "500": "ServerError",
    "502": "ServerError",
    "503": "ServiceUnavailableError",
    "504": "ServerError"
  },
